rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    function validProfile() {
      let p = request.resource.data;
      return p.keys().hasAll(['goal','level','mode','days','minutes','equipment','limitations','schemaVersion'])
        && p.keys().hasOnly(['goal','level','mode','days','minutes','equipment','limitations','schemaVersion'])
        && p.schemaVersion == 1
        && p.goal in ['Hipertrofia','Força','Condicionamento']
        && p.level in ['Iniciante','Intermediário','Avançado']
        && p.mode in ['Academia','Calistenia','Ambas']
        && p.minutes is int && p.minutes in [20,30,45,60,90]
        && p.days is list && p.days.size() >= 1 && p.days.size() <= 7
        && p.days.toSet().size() == p.days.size()
        && p.days.hasOnly(['Segunda','Terça','Quarta','Quinta','Sexta','Sábado','Domingo'])
        && p.equipment is list && p.equipment.size() >= 1 && p.equipment.size() <= 8
        && p.equipment.toSet().size() == p.equipment.size()
        && p.equipment.hasOnly(['Somente peso corporal','Halteres','Barra e anilhas','Máquinas','Barra fixa','Paralelas','Elásticos','Banco'])
        && (!('Somente peso corporal' in p.equipment) || p.equipment.size() == 1)
        && p.limitations is string && p.limitations.size() <= 500;
    }
    match /trainingProfiles/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validProfile();
      allow delete: if owner(uid);
    }
    match /weeklyPlans/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['schemaVersion','planJson'])
        && request.resource.data.keys().hasOnly(['schemaVersion','planJson'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.planJson is string
        && request.resource.data.planJson.size() > 0
        && request.resource.data.planJson.size() <= 40000;
      allow delete: if owner(uid);
    }
    match /workoutSessions/{uid}/entries/{sessionId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['schemaVersion','sessionJson'])
        && request.resource.data.keys().hasOnly(['schemaVersion','sessionJson'])
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
        && request.resource.data.sessionJson is string
        && request.resource.data.sessionJson.size() > 0 && request.resource.data.sessionJson.size() <= 100000;
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
